# Copier ce fichier en .env et remplir les valeurs

# Clé API Anthropic (pour la validation AI des photos)
# Obtenir sur https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Session
SESSION_SECRET=change-me-in-production
SESSION_COOKIE_NAME=udt.sid

# PostgreSQL (Supabase / Render)
# Example:
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres
DATABASE_URL=
# Optional for local non-SSL PostgreSQL only
# PG_DISABLE_SSL=1

# Supabase Storage (uploads photos)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public bucket name (must exist and be public)
SUPABASE_STORAGE_BUCKET=photos

# CORS (origines autorisées, séparées par virgule)
CORS_ORIGINS=http://localhost:5173

# HTTPS en dev (optionnel)
# DEV_HTTPS=1


