{
  "name": "udt-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "set DEV_HTTPS=1&& vite",
    "server": "node --env-file=.env src/server/index.js",
    "server:https": "set DEV_HTTPS=1&& node --env-file=.env src/server/index.js",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "dev:full:https": "concurrently \"npm run server:https\" \"npm run dev:https\"",
    "https:setup": "node scripts/setup-dev-https.mjs",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "mkcert": "^3.2.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-session": "^1.18.2",
    "leaflet": "^1.9.4",
    "sqlite3": "^6.0.1",
    "ws": "^8.17.1"
  }
}
